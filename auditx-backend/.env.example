# Copy to .env and adjust. docker-compose reads this file automatically.
ENVIRONMENT=development
POSTGRES_USER=auditx
POSTGRES_PASSWORD=auditx
POSTGRES_DB=auditx

# Used only when running the API outside Docker (local virtualenv):
DATABASE_URL=postgresql+psycopg2://auditx:auditx@localhost:5432/auditx
REDIS_URL=redis://localhost:6379/0
UPLOAD_DIR=./uploads

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-in-production-use-64-random-bytes
JWT_EXPIRE_MINUTES=720
CORS_ORIGINS=http://localhost:3000
# Dashboard URL used in invitation links (your Vercel URL in production)
APP_BASE_URL=http://localhost:3000

# Team invitation email (any SMTP provider). Leave SMTP_HOST empty to share invite links by hand.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=AuditX <no-reply@yourcompany.com>
SMTP_STARTTLS=true
SMTP_SSL=false
INVITE_EXPIRY_DAYS=7

# Optional WhatsApp alerts. Companies are opted out until their admin switches alerts on.
#   meta   = WhatsApp Business Cloud API (approved template with 3 body params: company, summary, link)
#   twilio = Twilio WhatsApp (Content template SID, or plain body in the sandbox)
#   log    = development: messages only go to the server log and the delivery log
#   empty  = WhatsApp off on this server (email alerts still work if SMTP is set)
WHATSAPP_PROVIDER=
WHATSAPP_META_TOKEN=
WHATSAPP_META_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=auditx_daily_alert
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_TWILIO_ACCOUNT_SID=
WHATSAPP_TWILIO_AUTH_TOKEN=
WHATSAPP_TWILIO_FROM=
WHATSAPP_TWILIO_CONTENT_SID=
# Hosts without a Celery worker: a cron job calls POST /api/v1/internal/alerts/run-due with this header value.
ALERTS_CRON_TOKEN=

# Optional: leave empty to use the built-in zero-cost heuristic SQL router.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# true = run background jobs in-process (no Redis / worker needed; free-tier single container)
CELERY_TASK_ALWAYS_EAGER=false
PARSER_CHUNK_ROWS=100000
WEB_CONCURRENCY=2
CELERY_CONCURRENCY=4

# Bank + COD reconciliation timing (days) and courier overcharge threshold
SETTLEMENT_LAG_DAYS=7
BANK_MATCH_WINDOW_DAYS=10
COD_DISPATCH_SLA_DAYS=7
COD_REMITTANCE_SLA_DAYS=10
PARCEL_STUCK_DAYS=21
COURIER_OVERCHARGE_RATIO=1.5
