# Copy to .env and fill in. Every setting is documented in app/config.py.
DATABASE_URL=sqlite:///./coldchain.db
JWT_SECRET=replace-with-64-random-characters
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now
APP_BASE_URL=http://localhost:8000
DISPLAY_TZ=Asia/Karachi

OFFLINE_AFTER_MINUTES=5
ESCALATION_MINUTES=15
REMINDER_MINUTES=30

# Email (any SMTP provider). Empty host = messages are only logged.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=ColdChain Monitor <alerts@example.com>

# WhatsApp: log | meta
WHATSAPP_PROVIDER=log
WHATSAPP_META_TOKEN=
WHATSAPP_META_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=coldchain_alert

# SMS: log | twilio | http
SMS_PROVIDER=log
SMS_HTTP_URL=
SMS_TWILIO_ACCOUNT_SID=
SMS_TWILIO_AUTH_TOKEN=
SMS_TWILIO_FROM=
